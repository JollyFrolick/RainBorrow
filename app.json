{
  "expo": {
    "name": "RainBorrow",
    "slug": "rainborrow",
    "scheme": "rainborrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/rainborrow-launch-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rainborrow.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/rainborrow-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rainborrow.app"
    },
    "web": {
      "favicon": "./assets/rainborrow-logo.png",
      "bundler": "metro",
      "name": "RainBorrow"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your location to help you find nearby umbrella stations."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a station QR code to borrow an umbrella.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/rainborrow-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9F5"
        }
      ]
    ]
  }
}
